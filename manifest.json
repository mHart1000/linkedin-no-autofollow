{
  "manifest_version": 3,
  "name": "LinkedIn No Auto-Follow",
  "version": "1.0",
  "description": "Automatically unchecks the 'Follow company' checkbox in LinkedIn Easy Apply forms.",
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "activeTab"],
  "icons": {
    "48": "icons/checkbox48.png"
  },
  "action": {
    "default_popup": "popup.html",
    "theme_icons": [
      {
        "light": "icons/checkbox48light.png",
        "dark": "icons/checkbox48.png",
        "size": 48
      }
    ]
  }
}
